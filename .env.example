# Copy to .env locally. Never commit real keys.
OPENROUTER_API_KEY=
# Comma-separated client_id:SHA-256-hex pairs. Do not put raw client keys here.
API_CLIENT_KEY_HASHES=
# Comma-separated exact browser origins allowed to access the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional request content limit (characters).
MAX_REQUEST_CHARS=20000

# PostgreSQL enables durable conversations, key management, and usage audit.
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=10
# Admin token protects key creation/revocation endpoints. Keep secret and rotate it.
NEXUS_ADMIN_TOKEN=
# In-process per-client rolling request limit. Use shared gateway limiting for multi-instance deployments.
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Maximum authenticated API requests per client per UTC day; set 0 to disable.
DAILY_REQUEST_QUOTA=100
# Maximum simultaneous outbound model requests per API process.
MAX_CONCURRENT_PROVIDER_CALLS=8
