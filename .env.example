# Copy this file to .env locally. Never commit real keys.
OPENROUTER_API_KEY=
# Comma-separated client_id:SHA-256-hex pairs. No raw client keys here.
API_CLIENT_KEY_HASHES=
# Comma-separated CORS origins; use exact origins, no wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional public API base URL for the frontend; empty means same-origin.
VITE_API_BASE_URL=
